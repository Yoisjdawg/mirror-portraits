                 },
                 {
                     "id":  "addon-msg",
                     "kind":  "event",
                     "target":  "CHAT_MSG_ADDON",
                     "purpose":  "receive hello/query/reply",
                     "file":  "Share.lua"
                 },
                 {
                     "id":  "roster",
                     "kind":  "event",
                     "target":  "GROUP_ROSTER_UPDATE",
                     "purpose":  "say hello to a new group",
                     "file":  "Share.lua"
                 },
                 {
                     "id":  "mouseover",
                     "kind":  "event",
                     "target":  "UPDATE_MOUSEOVER_UNIT",

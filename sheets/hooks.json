                     "file":  "Core.lua"
                 },
                 {
                     "id":  "world",
                     "kind":  "event",
                     "target":  "PLAYER_ENTERING_WORLD",
                     "purpose":  "run the Melty test mode",
                     "file":  "Core.lua"
                 },
                 {
                     "id":  "target",
                     "kind":  "event",
                     "target":  "PLAYER_TARGET_CHANGED",
                     "purpose":  "show your picture on the target frame when you target yourself",
                     "file":  "Portrait.lua"
                 },
                 {
                     "id":  "portrait-update",
                     "kind":  "event",
                     "target":  "UNIT_PORTRAIT_UPDATE",

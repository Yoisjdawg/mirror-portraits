                     "file":  "Share.lua"
                 },
                 {
                     "id":  "tooltip",
                     "kind":  "hook",
                     "target":  "GameTooltip OnTooltipSetUnit / TooltipDataProcessor",
                     "purpose":  "add the profile line to player tooltips",
                     "file":  "Share.lua"
                 },
                 {
                     "id":  "send",
                     "kind":  "api",
                     "target":  "C_ChatInfo.SendAddonMessage",
                     "purpose":  "send share rows",
                     "file":  "Share.lua"
                 },
                 {
                     "id":  "prefix",
                     "kind":  "api",
                     "target":  "C_ChatInfo.RegisterAddonMessagePrefix",
